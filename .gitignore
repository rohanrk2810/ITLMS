# Build output
target/
*.class
*.log

# Secrets - copy deploy/docker/.env.example to .env and fill it in; never commit .env
.env
*.env.local

# Local file storage written by file-service in development (its uploaded
# bytes, not the com.itilms.file.storage source package - the leading path
# anchors this to the one directory, so it does not also hide source code).
services/file-service/storage/

# Frontend
node_modules/
dist/
.vite/

# IDEs and OS
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Word documents and their lock files stay on this machine
*.docx
~$*

# Playwright output
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Flutter mobile app lives in its own git repo
mobile/

# Generated report and exported documents
docs/report/
docs/**/*.docx
docs/**/*.doc
docs/**/*.pdf
