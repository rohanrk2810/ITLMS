# Build output
target/
*.class
*.log

# Secrets - copy deploy/docker/.env.example to .env and fill it in; never commit .env
.env
*.env.local

# Local file storage written by file-service in development (its uploaded
# bytes, not the com.itilms.file.storage source package - the leading path
# anchors this to the one directory, so it does not also hide source code).
services/file-service/storage/

# Frontend
node_modules/
dist/
.vite/

# IDEs and OS
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
