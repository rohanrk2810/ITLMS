# ===========================================================================
# IT-ILMS - local environment
#
# Copy to .env in this directory and replace every CHANGE_ME value.
# .env is git-ignored: it holds real secrets and must never be committed.
#
# Generate strong values with, for example:
#   openssl rand -base64 48      (JWT_SECRET)
#   openssl rand -hex 32         (LIVEKIT_API_SECRET, POSTGRES_PASSWORD)
# ===========================================================================

# --- Database --------------------------------------------------------------
POSTGRES_USER=itilms
POSTGRES_PASSWORD=CHANGE_ME
# Host port for tools like DBeaver or psql. 5433 because a locally installed
# Postgres usually already holds 5432.
POSTGRES_HOST_PORT=5433

# --- Authentication --------------------------------------------------------
# Signs every access token. At least 32 bytes. Changing it logs everyone out.
JWT_SECRET=CHANGE_ME

# The first administrator, created on first start if no admin exists.
# Must satisfy the password policy: 8+ characters with upper case, lower case
# and a digit. Change it after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@itinstitute.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- Live classes (LiveKit) ------------------------------------------------
# Any key name; the secret must be at least 32 characters.
LIVEKIT_API_KEY=itilms-dev
LIVEKIT_API_SECRET=CHANGE_ME
# The address browsers use to reach LiveKit. For a device on another machine
# on the LAN, use this computer's LAN IP here, set LIVEKIT_NODE_IP to the same
# IP, and set BIND_ADDRESS=0.0.0.0.
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_NODE_IP=127.0.0.1

# --- Network ---------------------------------------------------------------
# 127.0.0.1 keeps every published port private to this computer.
BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=8080
FRONTEND_URL=http://localhost:5173

# --- Institute -------------------------------------------------------------
INSTITUTE_TIMEZONE=Asia/Kolkata
APP_LOG_LEVEL=INFO

# --- Email (notification-service) ---
# Locally every email lands in Mailpit: http://localhost:8025
# For real delivery set MAIL_HOST/PORT/USERNAME/PASSWORD and MAIL_SMTP_AUTH/TLS=true.
MAIL_ENABLED=true
MAIL_FROM=no-reply@itinstitute.local
