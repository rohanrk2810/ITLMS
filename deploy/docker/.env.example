# ===========================================================================
# IT-ILMS - local environment
#
# Copy to .env in this directory and replace every CHANGE_ME value.
# .env is git-ignored: it holds real secrets and must never be committed.
#
# Generate strong values with, for example:
#   openssl rand -base64 48      (JWT_SECRET)
#   openssl rand -hex 32         (LIVEKIT_API_SECRET, POSTGRES_PASSWORD)
# ===========================================================================

# --- Database --------------------------------------------------------------
POSTGRES_USER=itilms
POSTGRES_PASSWORD=CHANGE_ME
# Host port for tools like DBeaver or psql. 5433 because a locally installed
# Postgres usually already holds 5432.
POSTGRES_HOST_PORT=5433

# --- Authentication --------------------------------------------------------
# Signs every access token. At least 32 bytes. Changing it logs everyone out.
JWT_SECRET=CHANGE_ME

# The first administrator, created on first start if no admin exists.
# Must satisfy the password policy: 8+ characters with upper case, lower case
# and a digit. Change it after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@itinstitute.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- Live classes (LiveKit) ------------------------------------------------
# Any key name; the secret must be at least 32 characters.
LIVEKIT_API_KEY=itilms-dev
LIVEKIT_API_SECRET=CHANGE_ME
# The address browsers use to reach LiveKit. For a device on another machine
# on the LAN, use this computer's LAN IP here, set LIVEKIT_NODE_IP to the same
# IP, and set BIND_ADDRESS=0.0.0.0.
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_NODE_IP=127.0.0.1

# --- Network ---------------------------------------------------------------
# 127.0.0.1 keeps every published port private to this computer.
BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=8080
FRONTEND_URL=http://localhost:5173

# --- Institute -------------------------------------------------------------
INSTITUTE_TIMEZONE=Asia/Kolkata
APP_LOG_LEVEL=INFO

# --- Email (notification-service) ---
# Real email is used for TWO things only: the password sent when an admin creates an account (or resets a password)
# and the code sent for "forgot password". Everything else (fees, results, announcements) stays in-app, unless you
# also set MAIL_NOTIFICATIONS_ENABLED=true.
# Locally every email lands in Mailpit: http://localhost:8025 (the defaults below).
MAIL_ENABLED=true
MAIL_NOTIFICATIONS_ENABLED=false
MAIL_FROM=no-reply@itinstitute.local
MAIL_FROM_NAME=IT Institute
#
# --- Real delivery: pick ONE provider, uncomment its lines and replace MAIL_FROM above ---
# Option 1: Gmail (free, about 500 emails a day). Needs 2-Step Verification on the account, then
#   Google Account -> Security -> App passwords -> create one. Use that 16-character app password, NOT the account password.
#   MAIL_FROM must be that same Gmail address, or Gmail rewrites it.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=<the full gmail address>
# MAIL_PASSWORD=<the 16-character app password>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_TLS=true
#
# Option 2: Brevo (free: 300 emails/day, can send from your own domain). Brevo -> SMTP & API -> SMTP -> generate an SMTP key.
#   MAIL_FROM must be a sender you verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=<the SMTP login shown by Brevo, e.g. 9abc12001@smtp-brevo.com>
# MAIL_PASSWORD=<the SMTP key, NOT your Brevo account password>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_TLS=true

# Public sign-up on the register page. false (the default) shows "Online registration is not open" and students are
# admitted by staff instead. true lets anyone create a STUDENT account; they then see only the course list until staff
# approve a course request. Turn the human check (CAPTCHA below) on first if this is a public server.
SELF_REGISTRATION_ENABLED=false

# --- "Verify you are human" on sign-in, registration and forgot-password (identity-service) ---
# Cloudflare Turnstile (free, no card): dash.cloudflare.com -> Application security -> Turnstile -> Add widget.
# Add the hostnames this site is served from (and localhost for testing), mode Managed. You get a Site Key
# (public) and a Secret Key (private). With CAPTCHA_ENABLED=true both are required.
CAPTCHA_ENABLED=false
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=
# The SutraVidya desktop app cannot pass the widget (it runs in an embedded browser). A long random secret here, also
# given to the app at build time (ITILMS_DESKTOP_KEY), lets it sign in without the widget. At least 24 characters.
# CAPTCHA_DESKTOP_KEY=

# --- Sign in with Google and with a WhatsApp code (identity-service); both off until set ---
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID -> Web application.
# Under "Authorized JavaScript origins" add the site address (and http://localhost:5173 for testing).
# GOOGLE_CLIENT_ID=
# WhatsApp: Meta WhatsApp Cloud API. Needs a WhatsApp Business number (PHONE_NUMBER_ID), a permanent access token and an
# approved AUTHENTICATION template (one code variable + copy-code button). A 10-digit number gets the default country code.
WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_LANGUAGE=en
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Development only: print the code in the identity-service log instead of sending it. Never on a real server.
# WHATSAPP_DEV_LOG_CODES=false

# --- Files (file-service) ---
# STORAGE_BACKEND=local writes to the file-storage volume - nothing to set.
# For MinIO (Doc S17, the production choice) set STORAGE_BACKEND=minio and:
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=...
# MINIO_SECRET_KEY=...
# MINIO_BUCKET=itilms

# --- Code execution (codeexec-service) ---
# Practice editors run students' code on a Judge0 server you host yourself.
# Blank = switched off; lessons still work, the Run button says it is not set up.
# From the compose network, a Judge0 on this same computer is reached at
# http://host.docker.internal:2358
JUDGE0_URL=
# Only if you set AUTHN_HEADER / AUTHN_TOKEN in Judge0:
# JUDGE0_AUTH_HEADER=X-Auth-Token
# JUDGE0_AUTH_TOKEN=

# SQL questions run on the Oracle Free container in the compose file. Change this password anywhere but a laptop.
# ORACLE_PASSWORD=itilms_oracle_dev
# Blank ORACLE_URL falls back to the sandbox's SQLite.
# ORACLE_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1

# Or run Piston instead of Judge0 (works on Docker Desktop; Java is 15 only). See docs/08-code-execution.md.
# CODEEXEC_ENGINE=piston
# PISTON_URL=http://piston:2000

# --- Public server (Oracle Cloud etc.) -------------------------------------
# Everything else stays on 127.0.0.1 behind the Caddy reverse proxy; only
# LiveKit's media ports must be reachable from the internet directly.
# LIVEKIT_BIND_ADDRESS=0.0.0.0

# Razorpay (online course payment). Use Test mode keys first; leave empty to keep online payment off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
