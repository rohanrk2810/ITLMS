        timestamptz created_at
        timestamptz updated_at
        bigint created_by
        boolean microphone_required
        boolean tab_switch_check
        boolean attendance_penalty
        boolean strict_severity
        boolean auto_remove
        int auto_remove_after_critical
        boolean alert_trainer
