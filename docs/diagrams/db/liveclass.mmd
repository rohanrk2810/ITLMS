        int marks
        varchar status
        timestamptz asked_at
        int offset_seconds
        timestamptz closed_at
        timestamptz created_at
        text snippet
        varchar snippet_language
        text dataset
    }
    live_sessions {
        bigserial id PK
        bigint class_session_id UK
        bigint batch_id
        varchar batch_code
        varchar course_title
        bigint trainer_id
