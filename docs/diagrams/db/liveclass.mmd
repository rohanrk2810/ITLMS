erDiagram
    live_material_folders {
        bigserial id PK
        bigint owner_user_id
        varchar path
        timestamptz created_at
    }
    live_materials {
        bigserial id PK
        bigint owner_user_id
        varchar title
        text payload
        timestamptz created_at
        timestamptz updated_at
        bigint course_id
        varchar topic
        varchar tags
        varchar difficulty
        boolean shared
        varchar owner_name
        varchar folder
    }
    live_participant_events {
        bigserial id PK
        bigint live_session_id FK
        varchar identity
        bigint user_id
        varchar event_type
        varchar participant_sid
        timestamptz occurred_at
        varchar livekit_event_id UK
        timestamptz created_at
    }
    live_participants {
        bigserial id PK
        bigint live_session_id FK
        varchar identity
        bigint user_id
        bigint student_id
        varchar display_name
        varchar role
        timestamptz first_joined_at
        timestamptz last_left_at
