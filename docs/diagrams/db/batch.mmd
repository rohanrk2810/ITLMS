erDiagram
    attendance {
        bigint id PK
        bigint session_id FK
        bigint student_id
        varchar status
        varchar remark
        varchar source
        integer attended_minutes
        timestamptz marked_at
        bigint marked_by
        timestamptz corrected_at
        bigint corrected_by
    }
    batch_trainers {
        bigint id PK
        bigint batch_id FK
        bigint trainer_id
        bigint trainer_user_id
        varchar trainer_name
        varchar role
        timestamptz created_at
    }
    batches {
        bigint id PK
        varchar batch_code UK
        varchar name
        bigint course_id
        varchar course_code
        varchar course_title
        bigint trainer_id
        bigint trainer_user_id
        varchar trainer_name
        date start_date
        date end_date
        time start_time
        time end_time
        varchar class_days
        varchar mode
