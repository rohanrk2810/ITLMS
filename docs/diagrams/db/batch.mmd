        boolean attendance_auto
        varchar cancelled_reason
        timestamptz created_at
        timestamptz updated_at
        bigint created_by
        bigint updated_by
    }
    course_requests {
        bigint id PK
        bigint student_id
        bigint user_id
        varchar student_code
        varchar student_name
        varchar student_email
        varchar student_phone
        bigint course_id
        varchar course_code
        varchar course_title
