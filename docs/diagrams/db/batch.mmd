        varchar classroom
        varchar meeting_url
        varchar status
        timestamptz created_at
        timestamptz updated_at
        bigint created_by
        bigint updated_by
    }
    class_sessions {
        bigint id PK
        bigint batch_id FK
        bigint trainer_id
        bigint trainer_user_id
        date session_date
        time start_time
        time end_time
        varchar topic
        varchar mode
        varchar meeting_url
