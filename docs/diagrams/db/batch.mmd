        bigint approved_batch_id FK
        bigint enrollment_id FK
        timestamptz created_at
        timestamptz updated_at
        bigint created_by
        bigint updated_by
    }
    enrollments {
        bigint id PK
        bigint student_id
        bigint user_id
        varchar student_code
        varchar student_name
        bigint course_id
        bigint batch_id FK
        timestamptz enrolled_at
        varchar status
        date completion_date
        varchar dropped_reason
        timestamptz created_at
        timestamptz updated_at
        bigint created_by
        bigint updated_by
        date access_until
    }
